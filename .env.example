# ============ CheapKZ :: ТОКЕНЫ И НАСТРОЙКИ ============
# Скопируйте в .env и заполните. Это единственный файл, который нужно править перед деплоем.

# --- Обязательно ---
# Публичный адрес панели (для ссылок в алертах)
BASE_URL=http://localhost:8080

# Токен админ-доступа к веб-панели и API. Сгенерируйте: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-long-random-string

# Токен Telegram-бота от @BotFather (без него бот выключен, веб работает)
TELEGRAM_BOT_TOKEN=

# --- Опционально ---
# Токен Travelpayouts/Aviasales для мониторинга авиабилетов (https://www.travelpayouts.com)
TRAVELPAYOUTS_TOKEN=

# Прокси через запятую для анти-бана (HTTP/HTTPS). Пример:
# PROXIES=http://user:pass@1.2.3.4:8080,http://user:pass@5.6.7.8:3128
PROXIES=

# Порт API и веб-панели
PORT=8080

# Часовой пояс дайджестов и тихих часов
TZ_NAME=Asia/Almaty

# Название бренда в сообщениях бота и интерфейсе
BRAND_NAME=CheapKZ

# Свой User-Agent (по умолчанию — ротация реалистичных браузерных UA)
USER_AGENT=

# Глобальная вежливость: максимум одновременных исходящих запросов и задержка между ними, мс (диапазон)
MAX_CONCURRENCY=3
MIN_DELAY_MS=900..2400

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# Сколько дней хранить историю цен и доставленные алерты (0 — не чистить)
RETENTION_DAYS=365

# Разрешить наблюдения за адресами внутренней сети (localhost, 10.x, 192.168.x).
# По умолчанию выключено — это защита от SSRF. Включайте, только если мониторите
# собственный сервис в той же сети.
ALLOW_PRIVATE_TARGETS=0
